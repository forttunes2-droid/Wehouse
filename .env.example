# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Keep Apple hidden until the Apple provider and callback are configured.
VITE_APPLE_SIGN_IN_ENABLED=false

# NOTE: Never commit .env files with real keys to version control.
# The .env file is listed in .gitignore by default.
